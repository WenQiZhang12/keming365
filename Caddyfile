{
    email {$ACME_EMAIL}
}

# PUBLIC_DOMAINS accepts one or more comma-separated DNS names. Caddy redirects
# HTTP to HTTPS and manages certificate issuance and renewal automatically.
{$PUBLIC_DOMAINS} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # 云渲染平台使用旧兼容回调路径，直接交给 Django 保存成绩和时长。
    handle /experiment/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}
