# Public entry point
FRONTEND_PORT=8080

# MySQL container and Django database connection
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
DB_NAME=new365
DB_USER=keming365
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=mysql
DB_PORT=3306

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
REDIS_URL=redis://redis:6379/0

# Registration controls
ADMIN_REGISTRATION_CODE=
TEMP_ADMIN_REGISTRATION_CODE=
TEMP_ADMIN_MAX_DAYS=7

# AI assistant
AI_ASSISTANT_API_KEY=

# Third-party YunQ platform credentials
YUNQ_ACCESS_KEY=
YUNQ_PULLET_SECRET=
YUNQ_EXPERIMENT_SECRET=
YUNQ_ACCESS_KEYS=access-key-1:secret-1,access-key-2:secret-2
YQ_APPKEY_EXPERIMENT=
YQ_APPSECRET_EXPERIMENT=
YQ_APPKEY_FRAGMENT=
YQ_APPSECRET_FRAGMENT=
YQ_APPKEY_TRAINING=
YQ_APPSECRET_TRAINING=
