# Public HTTPS entry point. Point all listed DNS records to this server before
# starting the stack so Caddy can obtain and renew TLS certificates.
PUBLIC_DOMAINS=example.com,www.example.com
ACME_EMAIL=ops@example.com

# The frontend is available for diagnostics only on the Docker host.
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=8080

# MySQL container and Django database connection
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
DB_NAME=new365
DB_USER=keming365
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=mysql
DB_PORT=3306

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-at-least-50-characters
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
REDIS_URL=redis://redis:6379/0

# Registration controls

# AI assistant
AI_ASSISTANT_API_KEY=

# Third-party YunQ platform credentials
YUNQ_ACCESS_KEY=
YUNQ_PULLET_SECRET=
YUNQ_EXPERIMENT_SECRET=
YUNQ_ACCESS_KEYS=access-key-1:secret-1,access-key-2:secret-2
YQ_APPKEY_EXPERIMENT=
YQ_APPSECRET_EXPERIMENT=
YQ_APPKEY_FRAGMENT=
YQ_APPSECRET_FRAGMENT=
YQ_APPKEY_TRAINING=
YQ_APPSECRET_TRAINING=
